<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Рядок з'єднання з базою даних тестових наборів продубльовано тут
    лише для довідки: тести підключають дані атрибутом
    [DataSource("System.Data.SqlClient", CONNECTION_STRING,
                "RpnTestCases", DataAccessMethod.Sequential)],
    де CONNECTION_STRING — константа у файлі CreateStackTests.cs.
    Змінювати параметри підключення потрібно саме там.
  -->
  <connectionStrings>
    <add name="TestDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=CreateStackTestDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
